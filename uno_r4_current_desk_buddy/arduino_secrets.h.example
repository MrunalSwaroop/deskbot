#define SECRET_SSID "YOUR_WIFI_NAME"
#define SECRET_PASS "YOUR_WIFI_PASSWORD"

// Optional direct LLM access. These fields are for an OpenAI-compatible endpoint only.
// Do NOT put a Manus API key here. Use integration_relay/.env instead.
#define LLM_API_KEY "YOUR_LLM_API_KEY"
#define LLM_HOST "api.openai.com"
#define LLM_PATH "/v1/chat/completions"
#define LLM_MODEL "gpt-4o-mini"

// India Standard Time by default. Change for your location in seconds from UTC.
#define TIMEZONE_OFFSET_SECONDS 19800
